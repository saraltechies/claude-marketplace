<?php

namespace App\Http\Requests\Admin;

use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Validation\Rule;

class {{Model}}Request extends FormRequest
{
    public function authorize(): bool
    {
        // Routes are already behind the admin.auth middleware.
        return true;
    }

    /**
     * Normalize input before validation: an unticked checkbox sends nothing,
     * so turn it into a real boolean here and let validated() carry it.
     */
    protected function prepareForValidation(): void
    {
        $this->merge([
            'is_active' => $this->boolean('is_active'),
        ]);
    }

    public function rules(): array
    {
        return [
            'name' => [
                'required', 'string', 'max:255',
                Rule::unique('{{table}}', 'name')->ignore($this->route('{{modelVar}}')),
            ],
            'is_active' => ['boolean'],
        ];
    }
}
